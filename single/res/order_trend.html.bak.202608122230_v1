<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>订单趋势</title>
  <link rel="stylesheet" href="/res/fa/css/all.min.css">
  <style>
    :root {
      --primary: #4f7cff;
      --primary-dark: #3f68df;
      --page-bg: #f5f7ff;
      --card-bg: #ffffff;
      --text: #172033;
      --muted: #718096;
      --border: #e5ebf5;
      --success: #16a34a;
      --warning: #f59e0b;
      --danger: #ef4444;
      --shadow: 0 12px 32px rgba(91, 140, 255, .10);
      --soft-shadow: 0 4px 14px rgba(15, 23, 42, .05);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "PingFang SC", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body {
      min-height: 100vh;
      padding: 16px;
      color: var(--text);
      background: linear-gradient(135deg, #f8faff 0%, #eef3ff 100%);
    }

    .dashboard {
      width: 100%;
      max-width: 1360px;
      margin: 0 auto;
    }

    .panel {
      background: rgba(255, 255, 255, .98);
      border: 1px solid rgba(229, 235, 245, .9);
      border-radius: 18px;
      box-shadow: var(--shadow);
      padding: 18px;
      margin-bottom: 14px;
    }

    .header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 14px;
    }

    .title {
      position: relative;
      padding-left: 12px;
      font-size: 22px;
      line-height: 1.2;
      font-weight: 800;
      color: var(--text);
    }

    .title::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 4px;
      height: 22px;
      border-radius: 999px;
      background: var(--primary);
      transform: translateY(-50%);
    }

    .sub-title {
      margin-top: 8px;
      color: var(--muted);
      font-size: 13px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 32px;
      padding: 0 12px;
      border-radius: 999px;
      color: #2f5fd0;
      background: #eef4ff;
      border: 1px solid #dce7ff;
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--primary);
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 10px;
      padding: 12px;
      border-radius: 14px;
      background: #f8fbff;
      border: 1px solid #dfe8f8;
    }

    .field {
      min-width: 150px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field.wide {
      min-width: 220px;
      flex: 1;
    }

    .field label {
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
    }

    .field input,
    .field select {
      height: 38px;
      padding: 0 12px;
      border: 1px solid #d6e0f0;
      border-radius: 10px;
      background: #fff;
      color: var(--text);
      outline: none;
      font-size: 14px;
    }

    .field input:focus,
    .field select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(79, 124, 255, .12);
    }

    .segmented {
      height: 38px;
      display: inline-flex;
      align-items: center;
      padding: 3px;
      border: 1px solid #d6e0f0;
      border-radius: 12px;
      background: #fff;
      gap: 3px;
    }

    .segmented button,
    .btn {
      height: 30px;
      border: 0;
      border-radius: 9px;
      padding: 0 12px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      white-space: nowrap;
      transition: .18s ease;
    }

    .segmented button {
      color: #526174;
      background: transparent;
    }

    .segmented button.active {
      color: #fff;
      background: var(--primary);
    }

    .btn {
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      color: #fff;
      background: var(--primary);
      padding: 0 16px;
    }

    .btn:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-light {
      color: #3f68df;
      background: #eef4ff;
    }

    .btn-light:hover {
      background: #e2ebff;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .summary-card {
      padding: 14px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #fff;
      box-shadow: var(--soft-shadow);
    }

    .summary-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .summary-value {
      color: var(--text);
      font-size: 24px;
      line-height: 1.1;
      font-weight: 850;
    }

    .summary-note {
      margin-top: 8px;
      color: var(--muted);
      font-size: 12px;
    }

    .summary-note.up { color: var(--success); }
    .summary-note.down { color: var(--danger); }

    .split {
      display: grid;
      grid-template-columns: 1.5fr .9fr;
      gap: 14px;
    }

    .section-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
      font-size: 16px;
      font-weight: 800;
    }

    .section-title small {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
    }

    .chart-wrap {
      height: 330px;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 8px 4px 0;
    }

    .chart {
      min-width: 820px;
      height: 100%;
      display: grid;
      grid-template-columns: 48px 1fr;
      grid-template-rows: 1fr 42px;
      gap: 0 10px;
    }

    .axis-y {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: #93a0b4;
      font-size: 11px;
      text-align: right;
      padding-bottom: 10px;
    }

    .bars {
      display: grid;
      align-items: end;
      grid-auto-flow: column;
      grid-auto-columns: minmax(36px, 1fr);
      gap: 8px;
      border-left: 1px solid #e5ebf5;
      border-bottom: 1px solid #e5ebf5;
      padding: 10px 8px 0;
      background: repeating-linear-gradient(
        to top,
        transparent,
        transparent 58px,
        #eef2f8 59px
      );
    }

    .bar-group {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      min-width: 0;
    }

    .bar {
      width: 100%;
      min-height: 4px;
      border-radius: 8px 8px 0 0;
      background: linear-gradient(180deg, #7aa2ff 0%, #4f7cff 100%);
      box-shadow: 0 8px 18px rgba(79, 124, 255, .20);
      position: relative;
    }

    .bar.alert {
      background: linear-gradient(180deg, #ffb35a 0%, #f59e0b 100%);
      box-shadow: 0 8px 18px rgba(245, 158, 11, .18);
    }

    .bar strong {
      position: absolute;
      left: 50%;
      top: -22px;
      transform: translateX(-50%);
      font-size: 11px;
      color: #344054;
      white-space: nowrap;
    }

    .axis-x {
      grid-column: 2;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(36px, 1fr);
      gap: 8px;
      padding: 8px 8px 0;
      color: #69778b;
      font-size: 11px;
      text-align: center;
    }

    .rank-list {
      display: grid;
      gap: 10px;
    }

    .rank-item {
      display: grid;
      grid-template-columns: 34px 1fr auto;
      align-items: center;
      gap: 10px;
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #fff;
    }

    .rank-no {
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      color: #fff;
      background: var(--primary);
      font-weight: 850;
      font-size: 13px;
    }

    .rank-name {
      font-size: 14px;
      font-weight: 800;
      color: var(--text);
    }

    .rank-meta {
      margin-top: 4px;
      color: var(--muted);
      font-size: 12px;
    }

    .rank-value {
      text-align: right;
      font-weight: 850;
      color: var(--text);
    }

    .rank-value small {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #fff;
    }

    table {
      width: 100%;
      min-width: 980px;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 11px 12px;
      border-bottom: 1px solid #eef2f8;
      text-align: left;
      font-size: 13px;
      white-space: nowrap;
    }

    th {
      color: #526174;
      background: #f8fbff;
      font-weight: 850;
    }

    td {
      color: #27364a;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      height: 24px;
      padding: 0 9px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
    }

    .tag-normal {
      color: #137a3f;
      background: #eafaf1;
    }

    .tag-watch {
      color: #a86200;
      background: #fff4dc;
    }

    .tag-hot {
      color: #c1262c;
      background: #fff0f0;
    }

    .empty {
      padding: 28px;
      color: var(--muted);
      text-align: center;
      border: 1px dashed #d6e0f0;
      border-radius: 14px;
      background: #fbfdff;
    }

    @media (max-width: 980px) {
      .summary-grid,
      .split {
        grid-template-columns: 1fr;
      }

      .header {
        flex-direction: column;
      }
    }

    @media (max-width: 620px) {
      body {
        padding: 10px;
      }

      .panel {
        padding: 14px;
      }

      .field,
      .field.wide {
        min-width: 100%;
      }

      .segmented {
        width: 100%;
        height: auto;
        flex-wrap: wrap;
      }

      .segmented button {
        flex: 1;
        min-width: 76px;
      }
    }
  </style>
</head>
<body>
  <main class="dashboard">
    <section class="panel">
      <div class="header">
        <div>
          <h1 class="title">订单趋势</h1>
          <div class="sub-title">按 5 分钟、10 分钟、半小时和近 3 小时观察各场地驾驶订单波动。</div>
        </div>
        <div class="status-pill"><span class="status-dot"></span><span id="dataMode">页面预览数据</span></div>
      </div>

      <div class="filters">
        <div class="field">
          <label>统计粒度</label>
          <div class="segmented" id="rangeButtons">
            <button type="button" data-range="5">5分钟</button>
            <button type="button" data-range="10">10分钟</button>
            <button type="button" data-range="30">半小时</button>
            <button type="button" data-range="180" class="active">近3小时</button>
          </div>
        </div>
        <div class="field wide">
          <label>场地</label>
          <input id="venueKeyword" type="text" placeholder="输入场地ID或名称筛选">
        </div>
        <div class="field">
          <label>订单口径</label>
          <select id="statusFilter">
            <option value="driving">驾驶订单</option>
            <option value="completed">已完成</option>
            <option value="active">正在驾驶</option>
            <option value="all">全部状态</option>
          </select>
        </div>
        <button class="btn" id="refreshBtn" type="button"><i class="fas fa-sync-alt"></i>刷新</button>
        <button class="btn btn-light" id="mockBtn" type="button"><i class="fas fa-chart-bar"></i>预览数据</button>
      </div>
    </section>

    <section class="summary-grid" id="summaryGrid"></section>

    <section class="split">
      <div class="panel">
        <div class="section-title">
          <span>平台订单趋势</span>
          <small id="chartHint">按近3小时拆分</small>
        </div>
        <div class="chart-wrap">
          <div class="chart">
            <div class="axis-y" id="axisY"></div>
            <div class="bars" id="bars"></div>
            <div class="axis-x" id="axisX"></div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="section-title">
          <span>场地热度排行</span>
          <small>按订单数排序</small>
        </div>
        <div class="rank-list" id="rankList"></div>
      </div>
    </section>

    <section class="panel">
      <div class="section-title">
        <span>场地趋势明细</span>
        <small>后续接入后端后展示实时订单</small>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>场地</th>
              <th>近5分钟</th>
              <th>近10分钟</th>
              <th>近30分钟</th>
              <th>近3小时</th>
              <th>正在驾驶</th>
              <th>完成订单</th>
              <th>环比变化</th>
              <th>状态</th>
            </tr>
          </thead>
          <tbody id="detailBody"></tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    const API_URL = "/api/orders/order_trend.php";
    const state = {
      range: 180,
      rows: [],
      chart: []
    };

    const demoRows = [
      { venue_id: 104, venue_name: "104号场地", m5: 8, m10: 17, m30: 42, h3: 138, active: 12, completed: 126, change_rate: 18 },
      { venue_id: 81, venue_name: "81号场地", m5: 5, m10: 12, m30: 36, h3: 111, active: 9, completed: 102, change_rate: 9 },
      { venue_id: 30, venue_name: "30号场地", m5: 2, m10: 9, m30: 31, h3: 96, active: 7, completed: 89, change_rate: -7 },
      { venue_id: 87, venue_name: "87号场地", m5: 1, m10: 4, m30: 18, h3: 74, active: 5, completed: 69, change_rate: -18 },
      { venue_id: 115, venue_name: "115号场地", m5: 6, m10: 15, m30: 29, h3: 68, active: 11, completed: 57, change_rate: 35 },
      { venue_id: 22, venue_name: "22号场地", m5: 0, m10: 2, m30: 11, h3: 39, active: 2, completed: 37, change_rate: -22 },
      { venue_id: 35, venue_name: "35号场地", m5: 3, m10: 8, m30: 16, h3: 33, active: 3, completed: 30, change_rate: 4 },
      { venue_id: 90, venue_name: "90号场地", m5: 0, m10: 1, m30: 9, h3: 27, active: 1, completed: 26, change_rate: -31 }
    ];

    const demoChart = [
      ["14:30", 22], ["14:40", 28], ["14:50", 31], ["15:00", 25], ["15:10", 35], ["15:20", 42],
      ["15:30", 39], ["15:40", 44], ["15:50", 51], ["16:00", 48], ["16:10", 53], ["16:20", 61],
      ["16:30", 56], ["16:40", 64], ["16:50", 72], ["17:00", 69], ["17:10", 78], ["17:20", 83]
    ];

    function fmt(num) {
      return Number(num || 0).toLocaleString("zh-CN");
    }

    function rangeLabel(range) {
      if (Number(range) === 5) return "近5分钟";
      if (Number(range) === 10) return "近10分钟";
      if (Number(range) === 30) return "近半小时";
      return "近3小时";
    }

    function getRangeValue(row) {
      if (state.range === 5) return row.m5;
      if (state.range === 10) return row.m10;
      if (state.range === 30) return row.m30;
      return row.h3;
    }

    function statusTag(row) {
      if (row.m5 >= 6 || row.change_rate >= 30) return '<span class="tag tag-hot">高热</span>';
      if (row.change_rate <= -20 || row.m5 === 0) return '<span class="tag tag-watch">关注</span>';
      return '<span class="tag tag-normal">正常</span>';
    }

    function filteredRows() {
      const keyword = document.getElementById("venueKeyword").value.trim().toLowerCase();
      if (!keyword) return state.rows.slice();
      return state.rows.filter(row => {
        return String(row.venue_id).includes(keyword) || String(row.venue_name || "").toLowerCase().includes(keyword);
      });
    }

    function renderSummary(rows) {
      const active = rows.reduce((sum, row) => sum + Number(row.active || 0), 0);
      const completed = rows.reduce((sum, row) => sum + Number(row.completed || 0), 0);
      const current = rows.reduce((sum, row) => sum + Number(getRangeValue(row) || 0), 0);
      const hotVenues = rows.filter(row => row.m5 >= 6 || row.change_rate >= 30).length;
      const avgChange = rows.length ? rows.reduce((sum, row) => sum + Number(row.change_rate || 0), 0) / rows.length : 0;
      const changeClass = avgChange >= 0 ? "up" : "down";
      const changeText = (avgChange >= 0 ? "+" : "") + avgChange.toFixed(1) + "%";

      document.getElementById("summaryGrid").innerHTML = [
        ["当前区间订单", fmt(current), rangeLabel(state.range)],
        ["正在驾驶", fmt(active), "当前占用中的订单"],
        ["完成订单", fmt(completed), "近3小时完成口径"],
        ["异常关注场地", fmt(hotVenues), "高热或明显下滑"]
      ].map((item, index) => {
        const noteClass = index === 0 ? changeClass : "";
        const note = index === 0 ? "平均环比 " + changeText : item[2];
        return `
          <div class="summary-card">
            <div class="summary-label">${item[0]}</div>
            <div class="summary-value">${item[1]}</div>
            <div class="summary-note ${noteClass}">${note}</div>
          </div>
        `;
      }).join("");
    }

    function renderChart() {
      const max = Math.max(...state.chart.map(item => Number(item[1] || 0)), 1);
      const top = Math.ceil(max / 10) * 10;
      document.getElementById("axisY").innerHTML = [top, Math.round(top * .75), Math.round(top * .5), Math.round(top * .25), 0]
        .map(v => `<span>${v}</span>`)
        .join("");
      document.getElementById("bars").innerHTML = state.chart.map(item => {
        const value = Number(item[1] || 0);
        const height = Math.max(4, Math.round(value / top * 270));
        return `
          <div class="bar-group" title="${item[0]} ${value}单">
            <div class="bar ${value >= top * .78 ? "alert" : ""}" style="height:${height}px"><strong>${value}</strong></div>
          </div>
        `;
      }).join("");
      document.getElementById("axisX").innerHTML = state.chart.map(item => `<span>${item[0]}</span>`).join("");
      document.getElementById("chartHint").textContent = "按" + rangeLabel(state.range) + "拆分";
    }

    function renderRank(rows) {
      const sorted = rows.slice().sort((a, b) => getRangeValue(b) - getRangeValue(a)).slice(0, 8);
      document.getElementById("rankList").innerHTML = sorted.map((row, index) => `
        <div class="rank-item">
          <div class="rank-no">${index + 1}</div>
          <div>
            <div class="rank-name">${row.venue_name || "场地" + row.venue_id}</div>
            <div class="rank-meta">ID ${row.venue_id} · 正在驾驶 ${fmt(row.active)}</div>
          </div>
          <div class="rank-value">${fmt(getRangeValue(row))}<small>${rangeLabel(state.range)}</small></div>
        </div>
      `).join("") || '<div class="empty">暂无场地数据</div>';
    }

    function renderTable(rows) {
      document.getElementById("detailBody").innerHTML = rows.map(row => {
        const change = Number(row.change_rate || 0);
        const changeClass = change >= 0 ? "up" : "down";
        const changeText = (change >= 0 ? "+" : "") + change + "%";
        return `
          <tr>
            <td><strong>${row.venue_name || "场地" + row.venue_id}</strong> <span style="color:#8a98ab;">#${row.venue_id}</span></td>
            <td>${fmt(row.m5)}</td>
            <td>${fmt(row.m10)}</td>
            <td>${fmt(row.m30)}</td>
            <td>${fmt(row.h3)}</td>
            <td>${fmt(row.active)}</td>
            <td>${fmt(row.completed)}</td>
            <td class="${changeClass}">${changeText}</td>
            <td>${statusTag(row)}</td>
          </tr>
        `;
      }).join("") || '<tr><td colspan="9"><div class="empty">暂无匹配数据</div></td></tr>';
    }

    function renderAll() {
      const rows = filteredRows();
      renderSummary(rows);
      renderChart();
      renderRank(rows);
      renderTable(rows);
    }

    function useDemoData() {
      state.rows = demoRows.slice();
      state.chart = demoChart.slice();
      document.getElementById("dataMode").textContent = "页面预览数据";
      renderAll();
    }

    async function loadData() {
      const url = API_URL + "?range=" + encodeURIComponent(state.range) + "&status=" + encodeURIComponent(document.getElementById("statusFilter").value);
      try {
        const response = await fetch(url, { credentials: "include" });
        const result = await response.json();
        if (!result || Number(result.code) !== 0) throw new Error(result && result.msg ? result.msg : "接口未就绪");
        state.rows = Array.isArray(result.data && result.data.venues) ? result.data.venues : [];
        state.chart = Array.isArray(result.data && result.data.trend) ? result.data.trend : [];
        document.getElementById("dataMode").textContent = "后端实时数据";
        renderAll();
      } catch (error) {
        useDemoData();
      }
    }

    document.getElementById("rangeButtons").addEventListener("click", event => {
      const button = event.target.closest("button[data-range]");
      if (!button) return;
      document.querySelectorAll("#rangeButtons button").forEach(item => item.classList.remove("active"));
      button.classList.add("active");
      state.range = Number(button.dataset.range);
      renderAll();
    });

    document.getElementById("venueKeyword").addEventListener("input", renderAll);
    document.getElementById("statusFilter").addEventListener("change", loadData);
